run = "cd backend && pip install -r requirements.txt && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"
language = "python3"

[env]
APP_ENV = "production"
DATABASE_URL = "sqlite:///./audienceos.db"

[nix]
channel = "stable-21_11"

[deployment]
run = ["sh", "-c", "cd backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"]