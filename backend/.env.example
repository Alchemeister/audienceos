# AudienceOS Backend Environment Variables

# === App Configuration ===
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
SECRET_KEY=change-me-in-production
DEBUG=true

# === Database ===
# For local dev (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./audienceos.db
# For production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/audienceos

# === Redis ===
REDIS_URL=redis://localhost:6379

# === AI Services ===
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
# Optional fallback (GPT-4o-mini used if DeepSeek not set)
OPENAI_API_KEY=

# === Reddit API ===
# Create app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=audienceos/1.0

# === Optional Services ===

# Twitter/X API
TWITTER_BEARER_TOKEN=

# GitHub Token (for higher rate limits)
GITHUB_TOKEN=

# Email delivery (Resend)
RESEND_API_KEY=

# Error tracking (Sentry)
SENTRY_DSN=

# === Stripe ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# === Feature Flags ===
ENABLE_TWITTER=false
ENABLE_GITHUB=false
