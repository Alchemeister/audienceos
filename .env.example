# AudienceOS Environment Variables

# === Required ===

# Anthropic Claude API (for AI analysis + content generation)
ANTHROPIC_API_KEY=sk-ant-...

# Database (PostgreSQL for production, SQLite works for local dev)
DATABASE_URL=postgresql://user:password@localhost:5432/audienceos
# For local dev: DATABASE_URL=sqlite:///./audienceos.db

# Redis (for background job queue)
REDIS_URL=redis://localhost:6379

# === Reddit API (Required for audience research) ===
# Create app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=audienceos/1.0 by /u/yourusername

# === Optional but Recommended ===

# Twitter/X API (enables Twitter features)
# Get from https://developer.twitter.com
TWITTER_BEARER_TOKEN=

# GitHub Token (higher rate limits for GitHub API)
# Create at https://github.com/settings/tokens
GITHUB_TOKEN=

# Email delivery (for weekly reports)
# Get from https://resend.com
RESEND_API_KEY=

# Error tracking
# Get from https://sentry.io
SENTRY_DSN=

# === Stripe (for payments) ===
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_INDIE=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...

# === App Configuration ===
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
SECRET_KEY=your-secret-key-change-in-production

# === Feature Flags ===
ENABLE_TWITTER=false
ENABLE_GITHUB=false
